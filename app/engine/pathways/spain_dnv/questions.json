      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["routing.has_dependents", "yes"] }
    },
    {
      "key": "identity.nationality",
      "depends_on": ["routing.has_dependents"],
      "label": "What is your nationality?",
      "input_type": "text",
      "required": true,
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "identity.country_of_residence",
      "depends_on": ["identity.nationality"],
      "label": "What is your current legal country of residence?",
      "input_type": "text",
      "required": true,
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "routing.passport_validity_months",
      "depends_on": ["identity.country_of_residence"],
      "label": "How many months will your passport be valid from your intended Spain application or entry date?",
      "input_type": "number",
      "required": true,
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "routing.health_insurance_status",
      "depends_on": ["routing.passport_validity_months"],
      "label": "Do you have qualifying health insurance for Spain, or will you obtain it?",
      "input_type": "choice",
      "required": true,
      "choices": ["have_it", "will_obtain", "not_ready"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "documents.police_clearance_available",
      "depends_on": ["routing.health_insurance_status"],
      "label": "Can you obtain a criminal background certificate or police clearance?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "routing.criminal_record_flag",
      "depends_on": ["documents.police_clearance_available"],
      "label": "Do you have any criminal convictions that may appear on a background check?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "documents.civil_documents_available",
      "depends_on": ["routing.criminal_record_flag"],
      "label": "Do you have the civil documents required for your Spain DNV application?",
      "description": "Examples may include passport identity pages, civil registry documents, or other identity and family-status documents requested for filing.",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "documents.apostille_translation_ready",
      "depends_on": ["documents.civil_documents_available"],
      "label": "Do your foreign documents have apostille, legalization, or official Spanish translation where required?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "routing.renewal_compliance_acknowledged",
      "depends_on": ["documents.apostille_translation_ready"],
      "label": "Do you meet the Spain DNV renewal or ongoing compliance requirements?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "routing.additional_information",
      "depends_on": ["routing.renewal_compliance_acknowledged"],
