{
  "pathway": "spain_dnv",
  "source": {
    "type": "typeform_export_refactor",
    "file": "data/source/Spain_DNV_Typeform_Questions.xlsx",
    "form_id": "o0x98iMZ",
    "title": "Spain DNV with HubSpot meeting scheduler"
  },
  "taxonomy_fields": [
    {
      "key": "routing.service_interest",
      "depends_on": [],
      "label": "Are you seeking services related to the Digital Nomad Visa, tax, or both?",
      "description": "If you are interested in both services, please select both options.",
      "input_type": "multi_choice",
      "required": true,
      "choices": ["digital_nomad_visa", "tax_services"]
    },
    {
      "key": "routing.work_relationship",
      "depends_on": ["routing.service_interest"],
      "label": "How would you describe your profession or current occupation?",
      "input_type": "choice",
      "required": true,
      "choices": ["business_owner", "contractor", "employee"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "role.contractor.service_agreements_available",
      "depends_on": ["routing.work_relationship"],
      "label": "As a self-employed professional, do you collaborate with other businesses and have the ability to secure service agreements or contracts when needed?",
      "input_type": "choice",
      "required": true,
      "choices": ["can_secure_service_agreements", "cannot_secure_service_agreements"],
      "applies_when": { "equals": ["routing.work_relationship", "contractor"] }
    },
    {
      "key": "role.profession_description",
      "depends_on": ["routing.work_relationship"],
      "label": "What is your current profession? For example, Software Engineer.",
      "input_type": "text",
      "required": true,
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "routing.income_foreign_only",
      "depends_on": ["role.profession_description"],
      "label": "Is all of the income supporting your Spain Digital Nomad Visa application earned from outside Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "income.gross_monthly_income_band_eur",
      "depends_on": ["routing.income_foreign_only"],
      "label": "What is your gross monthly income before tax?",
      "description": "Consider your Gross Monthly Income from recent months or the amount you could reasonably earn in the coming months, if necessary, to meet the visa requirements.",
      "input_type": "choice",
      "required": true,
      "choices": ["below_2800", "eur_2800_5000", "eur_5000_10000", "above_10000"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "income.income_evidence_types",
      "depends_on": ["income.gross_monthly_income_band_eur"],
      "label": "Which documents can you provide as proof of income or professional activity?",
      "input_type": "multi_choice",
      "required": true,
      "choices": [
        "bank_statements",
        "employment_contract",
        "pay_stubs",
        "service_agreements_or_contracts",
        "invoices",
        "business_registration",
        "tax_returns_or_financial_statements",
        "other"
      ],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "income.income_history_months",
      "depends_on": ["income.income_evidence_types"],
      "label": "For how many months can you prove this income with those documents?",
      "input_type": "choice",
      "required": true,
      "choices": ["less_than_3", "3_to_5", "6_to_11", "12_or_more"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "routing.has_dependents",
      "depends_on": ["income.income_history_months"],
      "label": "Are you applying as an individual or with family dependents?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "contains": ["routing.service_interest", "digital_nomad_visa"] }
    },
    {
      "key": "routing.dependents_count",
      "depends_on": ["routing.has_dependents"],
      "label": "How many dependents are included in your application?",
      "input_type": "choice",
      "required": true,
      "choices": ["1", "2", "3", "4_or_more"],
      "applies_when": { "equals": ["routing.has_dependents", "yes"] }
    },
    {
      "key": "routing.dependent_relationships",
      "depends_on": ["routing.dependents_count"],
      "label": "What is each dependent's relationship to you?",
      "input_type": "text",
      "required": true,
      "applies_when": { "equals": ["routing.has_dependents", "yes"] }
    },
    {
      "key": "routing.dependent_ages",
      "depends_on": ["routing.dependents_count"],
      "label": "What is the age of each dependent?",
      "input_type": "text",
      "required": true,
      "applies_when": { "equals": ["routing.has_dependents", "yes"] }
    },
    {
      "key": "documents.dependent_documents_available",
      "depends_on": ["routing.has_dependents"],
