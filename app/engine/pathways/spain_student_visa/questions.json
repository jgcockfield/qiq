{
  "pathway": "spain_student_visa",
  "source": {
    "type": "requirements_reference",
    "file": "app/engine/pathways/spain_student_visa/requirements_reference.md",
    "title": "Spain Student Visa Requirements Reference"
  },
  "taxonomy_fields": [
    {
      "key": "routing.applicant_type",
      "depends_on": [],
      "label": "Are you applying as an individual or with family dependents?",
      "input_type": "choice",
      "required": true,
      "choices": ["individual", "family"]
    },
    {
      "key": "identity.nationality",
      "depends_on": ["routing.applicant_type"],
      "label": "What is your nationality?",
      "input_type": "text",
      "required": true
    },
    {
      "key": "identity.eu_eea_swiss_or_free_movement_status",
      "depends_on": ["identity.nationality"],
      "label": "Are you a citizen of an EU, EEA, or Swiss country?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "identity.eu_family_member_route",
      "depends_on": ["identity.eu_eea_swiss_or_free_movement_status"],
      "label": "Are you applying in Spain under EU family-member residence rules?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["identity.eu_eea_swiss_or_free_movement_status", "no"] }
    },
    {
      "key": "routing.application_route",
      "depends_on": ["identity.eu_family_member_route"],
      "label": "Where will you submit your student visa or residence application?",
      "input_type": "choice",
      "required": true,
      "choices": ["from_outside_spain", "from_within_spain"]
    },
    {
      "key": "routing.lawful_status_in_spain",
      "depends_on": ["routing.application_route"],
      "label": "Are you currently in Spain with valid legal immigration status?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["routing.application_route", "from_within_spain"] }
    },
    {
      "key": "study.category",
      "depends_on": ["routing.application_route"],
      "label": "What type of study-stay activity will you pursue in Spain?",
      "input_type": "choice",
      "required": true,
      "choices": [
        "higher_studies",
        "post_compulsory_secondary",
        "student_mobility",
        "specialized_health_training",
        "volunteering",
        "training",
        "other"
      ]
    },
    {
      "key": "study.accepted_by_authorized_institution",
      "depends_on": ["study.category"],
      "label": "Have you been accepted by an authorized educational institution in Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "study.full_time_recognized_program",
      "depends_on": ["study.accepted_by_authorized_institution"],
      "label": "Is your program a recognized full-time course of study?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "study.modality",
      "depends_on": ["study.full_time_recognized_program"],
      "label": "How will you attend the program?",
      "input_type": "choice",
      "required": true,
      "choices": ["in_person", "hybrid", "online"]
    },
    {
      "key": "study.in_person_requirement_met",
      "depends_on": ["study.modality"],
      "label": "Does your program meet Spain's required in-person attendance conditions?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "not_equals": ["study.modality", "in_person"] }
    },
    {
      "key": "study.program_duration_months",
      "depends_on": ["study.modality"],
      "label": "How many months will your program last?",
      "input_type": "number",
      "required": true
    },
    {
      "key": "study.application_timing_days",
      "depends_on": ["study.program_duration_months"],
      "label": "How many days before your program begins do you plan to submit your application?",
      "input_type": "number",
      "required": true
    },
    {
      "key": "study.application_timing_justification_available",
      "depends_on": ["study.application_timing_days"],
      "label": "Do you have a justified reason for submitting your application less than 60 days before the program begins?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "less_than": ["study.application_timing_days", 60] }
    },
    {
      "key": "study.enrollment_payment_status",
      "depends_on": ["study.application_timing_days"],
      "label": "Have you completed the required enrollment or tuition-payment step for your program?",
      "input_type": "choice",
      "required": true,
      "choices": [
        "paid_or_proven",
        "responsible_declaration_available",
        "not_available"
      ]
    },
    {
      "key": "financial.monthly_funds_eur",
      "depends_on": ["study.enrollment_payment_status"],
      "label": "What is the total monthly amount in EUR available to support you during your stay in Spain?",
      "description": "Spain Student Visa screening uses the official IPREM-based financial requirement for the main applicant and any dependents.",
      "input_type": "number",
      "required": true
    },
    {
      "key": "financial.accommodation_prepaid_full_stay",
      "depends_on": ["financial.monthly_funds_eur"],
      "label": "Have you prepaid accommodation for your full stay in Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "financial.funds_evidence_types",
      "depends_on": ["financial.accommodation_prepaid_full_stay"],
      "label": "Which documents can you provide as evidence of your financial means?",
      "input_type": "multi_choice",
      "required": true,
      "choices": [
        "bank_statements",
        "scholarship",
        "family_support",
        "grant",
        "other"
      ]
    },
    {
      "key": "routing.dependents_count",
      "depends_on": ["routing.applicant_type"],
      "label": "How many dependents are included in your application?",
      "input_type": "number",
      "required": true,
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.dependent_relationships",
      "depends_on": ["routing.dependents_count"],
      "label": "What is each dependent's relationship to you?",
      "input_type": "text",
      "required": true,
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.dependent_ages",
      "depends_on": ["routing.dependents_count"],
      "label": "What is the age of each dependent?",
      "input_type": "text",
      "required": true,
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.dependents_work_intent",
      "depends_on": ["routing.dependent_ages"],
      "label": "Do any of your dependents plan to work while living in Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.passport_validity_months",
      "depends_on": ["identity.nationality"],
      "label": "How many months will your passport be valid from your intended Spain application or entry date?",
      "input_type": "number",
      "required": true
    },
    {
      "key": "routing.health_insurance_status",
      "depends_on": ["routing.passport_validity_months"],
      "label": "Do you have qualifying health insurance for Spain, or will you obtain it?",
      "input_type": "choice",
      "required": true,
      "choices": ["have_it", "will_obtain", "no"]
    },
    {
      "key": "identity.age",
      "depends_on": ["routing.health_insurance_status"],
      "label": "What is your age?",
      "input_type": "number",
      "required": true
    },
    {
      "key": "routing.background_check_available",
      "depends_on": ["identity.age"],
      "label": "Can you obtain the required criminal background certificate or police clearance?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "greater_than": ["study.program_duration_months", 6] }
    },
    {
      "key": "routing.criminal_record_flag",
      "depends_on": ["routing.background_check_available"],
      "label": "Do you have any criminal convictions that may appear on a background check?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "greater_than": ["study.program_duration_months", 6] }
    },
    {
      "key": "routing.public_order_security_risk_flag",
      "depends_on": ["routing.criminal_record_flag"],
      "label": "Have you ever been refused entry to Spain or another Schengen country, been deported, or been flagged as a public-order or security risk?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "routing.public_health_disease_flag",
      "depends_on": ["routing.public_order_security_risk_flag"],
      "label": "Do you have any disease with serious public-health implications under the International Health Regulations?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "study.student_work_intent",
      "depends_on": ["routing.public_health_disease_flag"],
      "label": "Do you plan to work while studying in Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "routing.additional_information",
      "depends_on": ["study.student_work_intent"],
      "label": "What else about your Spain Student Visa situation should QIQ consider?",
      "input_type": "text",
      "required": false
    }
  ]
}
