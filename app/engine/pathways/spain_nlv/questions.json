{
  "pathway": "spain_nlv",
  "source": {
    "type": "requirements_reference",
    "file": "app/engine/pathways/spain_nlv/requirements_reference.md",
    "title": "Spain Non-Lucrative Visa Requirements Reference"
  },
  "taxonomy_fields": [
    {
      "key": "routing.applicant_type",
      "depends_on": [],
      "label": "Are you applying as an individual or with family dependents?",
      "input_type": "choice",
      "required": true,
      "choices": ["individual", "family"]
    },
    {
      "key": "identity.nationality",
      "depends_on": ["routing.applicant_type"],
      "label": "What is your nationality?",
      "input_type": "text",
      "required": true
    },
    {
      "key": "identity.eu_eea_swiss_or_free_movement_status",
      "depends_on": ["identity.nationality"],
      "label": "Are you an EU, EEA, or Swiss citizen, or covered by EU free-movement rules?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no", "not_sure"]
    },
    {
      "key": "routing.no_work_activity_acknowledged",
      "depends_on": ["identity.eu_eea_swiss_or_free_movement_status"],
      "label": "Is your Spain Non-Lucrative Visa case based on living in Spain without working or carrying out professional activity there?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no", "not_sure"]
    },
    {
      "key": "routing.irregular_presence_spain",
      "depends_on": ["routing.no_work_activity_acknowledged"],
      "label": "Are you currently irregularly present in Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no", "not_sure"]
    },
    {
      "key": "financial.monthly_passive_income_or_assets_eur",
      "depends_on": ["routing.irregular_presence_spain"],
      "label": "What monthly amount in EUR can you support from passive income or available assets without working in Spain?",
      "description": "Spain NLV screening uses the official IPREM-based financial requirement for the main applicant and any dependents.",
      "input_type": "number",
      "required": true
    },
    {
      "key": "financial.funds_evidence_types",
      "depends_on": ["financial.monthly_passive_income_or_assets_eur"],
      "label": "Which documents can you provide as proof of passive income or available assets?",
      "input_type": "multi_choice",
      "required": true,
      "choices": [
        "bank_certificates",
        "property_titles",
        "certified_checks",
        "credit_cards_with_bank_certification",
        "passive_income_proof",
        "other"
      ]
    },
    {
      "key": "financial.spanish_company_ownership",
      "depends_on": ["financial.funds_evidence_types"],
      "label": "Do any of the funds supporting your Spain NLV case come from shares or ownership in a company based in Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "financial.spanish_company_no_labor_activity_acknowledged",
      "depends_on": ["financial.spanish_company_ownership"],
      "label": "If those funds come from a Spanish company, can you confirm you do not perform labor or professional activity for that company?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no", "not_sure"],
      "applies_when": { "equals": ["financial.spanish_company_ownership", "yes"] }
    },
    {
      "key": "routing.dependents_count",
      "depends_on": ["routing.applicant_type"],
      "label": "How many dependents are included in your application?",
      "input_type": "number",
      "required": true,
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.dependent_relationships",
      "depends_on": ["routing.dependents_count"],
      "label": "What is each dependent's relationship to you?",
      "input_type": "text",
      "required": true,
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.dependent_ages",
      "depends_on": ["routing.dependents_count"],
      "label": "What is the age of each dependent?",
      "input_type": "text",
      "required": true,
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.minor_children_schooling_acknowledged",
      "depends_on": ["routing.dependent_ages"],
      "label": "If any dependent children are of compulsory school age, can they be enrolled during your stay in Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["no_minor_children", "can_enroll", "cannot_enroll", "not_sure"],
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.passport_validity_months",
      "depends_on": ["identity.nationality"],
      "label": "How many months will your passport be valid from your intended Spain application or entry date?",
      "input_type": "number",
      "required": true
    },
    {
      "key": "routing.health_insurance_status",
      "depends_on": ["routing.passport_validity_months"],
      "label": "Do you have qualifying health insurance with an insurer authorized to operate in Spain, or will you obtain it?",
      "input_type": "choice",
      "required": true,
      "choices": ["have_it", "will_obtain", "cannot_obtain"]
    },
    {
      "key": "routing.background_check_available",
      "depends_on": ["routing.health_insurance_status"],
      "label": "Can you obtain criminal record certificates for your country of origin and countries of residence during the previous 5 years?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no", "not_sure"]
    },
    {
      "key": "routing.criminal_record_flag",
      "depends_on": ["routing.background_check_available"],
      "label": "Do you have any criminal convictions that may appear on those background checks?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no", "not_sure"]
    },
    {
      "key": "routing.public_order_security_risk_flag",
      "depends_on": ["routing.criminal_record_flag"],
      "label": "Are you aware of any public-order, security, or entry-ban issue that may affect admission to Spain?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no", "not_sure"]
    },
    {
      "key": "routing.public_health_disease_flag",
      "depends_on": ["routing.public_order_security_risk_flag"],
      "label": "Do you have any disease with serious public-health implications under the International Health Regulations?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no", "not_sure"]
    },
    {
      "key": "routing.renewal_residence_days_expected",
      "depends_on": ["routing.public_health_disease_flag"],
      "label": "If you plan to renew, do you expect to reside in Spain more than 183 days per calendar year?",
      "input_type": "choice",
      "required": true,
      "choices": ["more_than_183_days", "183_days_or_less", "not_sure", "not_planning_to_renew"]
    },
    {
      "key": "routing.additional_information",
      "depends_on": ["routing.renewal_residence_days_expected"],
      "label": "What else about your Spain Non-Lucrative Visa situation should QIQ consider?",
      "input_type": "text",
      "required": false
    }
  ]
}
