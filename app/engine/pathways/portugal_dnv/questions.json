{
  "pathway": "portugal_dnv",
  "source": {
    "type": "requirements_reference",
    "file": "app/engine/pathways/portugal_dnv/requirements_reference.md",
    "title": "Portugal Digital Nomad Visa Requirements Reference"
  },
  "taxonomy_fields": [
    {
      "key": "routing.visa_route",
      "depends_on": [],
      "label": "Which Portugal remote-work visa route are you considering?",
      "input_type": "choice",
      "required": true,
      "choices": ["residence_visa", "temporary_stay_under_1_year"]
    },
    {
      "key": "routing.work_relationship",
      "depends_on": ["routing.visa_route"],
      "label": "What best describes your work relationship?",
      "input_type": "choice",
      "required": true,
      "choices": ["remote_employee", "freelancer_independent", "business_owner_company_service"]
    },
    {
      "key": "routing.applicant_type",
      "depends_on": ["routing.work_relationship"],
      "label": "Are you applying as an individual or with family dependents?",
      "input_type": "choice",
      "required": true,
      "choices": ["individual", "family"]
    },
    {
      "key": "work.entities_outside_portugal",
      "depends_on": ["routing.applicant_type"],
      "label": "Is your professional activity performed remotely for an employer, client, or business entity outside Portugal?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "role.employee.contract_or_declaration_available",
      "depends_on": ["work.entities_outside_portugal"],
      "label": "Do you have an employment contract, promise of contract, or employer declaration for your remote work?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["routing.work_relationship", "remote_employee"] }
    },
    {
      "key": "role.independent.service_or_client_proof_available",
      "depends_on": ["work.entities_outside_portugal"],
      "label": "Do you have service contracts, a written service proposal, or other proof of the services you provide?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["routing.work_relationship", "freelancer_independent"] }
    },
    {
      "key": "role.business_owner.company_service_documents_available",
      "depends_on": ["work.entities_outside_portugal"],
      "label": "Do you have company documents plus contracts, proposals, or client proof showing your remote business activity?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["routing.work_relationship", "business_owner_company_service"] }
    },
    {
      "key": "financial.average_monthly_income_last_3_months_eur",
      "depends_on": ["role.employee.contract_or_declaration_available", "role.independent.service_or_client_proof_available", "role.business_owner.company_service_documents_available"],
      "label": "What was your average monthly income in EUR over the last 3 months?",
      "description": "Portugal Digital Nomad Visa screening uses the 2026 threshold of EUR 3,680 per month, equal to 4x the EUR 920 monthly minimum wage.",
      "input_type": "number",
      "required": true
    },
    {
      "key": "financial.income_evidence_types",
      "depends_on": ["financial.average_monthly_income_last_3_months_eur"],
      "label": "Which documents can you provide as evidence of this income?",
      "input_type": "multi_choice",
      "required": true,
      "choices": [
        "payslips",
        "invoices",
        "contracts",
        "bank_statements",
        "income_proof",
        "other"
      ]
    },
    {
      "key": "documents.tax_residence_certificate_available",
      "depends_on": ["financial.income_evidence_types"],
      "label": "Can you obtain a tax residence certificate from your country of tax residence?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "routing.dependents_count",
      "depends_on": ["documents.tax_residence_certificate_available"],
      "label": "How many dependents are included in your application?",
      "input_type": "number",
      "required": true,
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "routing.dependent_relationships",
      "depends_on": ["routing.dependents_count"],
      "label": "What is each dependent's relationship to you?",
      "input_type": "text",
      "required": true,
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "financial.family_stable_means_available",
      "depends_on": ["routing.dependent_relationships"],
      "label": "Do you have additional stable and regular financial means available to support your dependents?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["routing.applicant_type", "family"] }
    },
    {
      "key": "identity.nationality",
      "depends_on": ["documents.tax_residence_certificate_available"],
      "label": "What is your nationality?",
      "input_type": "text",
      "required": true
    },
    {
      "key": "routing.application_country_matches_nationality",
      "depends_on": ["identity.nationality"],
      "label": "Are you applying from your country of nationality?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "key": "routing.lawful_residence_where_applying",
      "depends_on": ["routing.application_country_matches_nationality"],
      "label": "Is your lawful residence in the country where you will apply valid beyond the requested visa period?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "equals": ["routing.application_country_matches_nationality", "no"] }
    },
    {
      "key": "routing.passport_validity_months",
      "depends_on": ["routing.application_country_matches_nationality"],
      "label": "How many months will your passport be valid beyond your intended stay or return date?",
      "input_type": "number",
      "required": true
    },
    {
      "key": "routing.health_travel_insurance_status",
      "depends_on": ["routing.passport_validity_months"],
      "label": "Which best describes your health or travel insurance for Portugal?",
      "input_type": "choice",
      "required": true,
      "choices": ["have_it", "will_obtain", "bilateral_exception_applies", "cannot_obtain"]
    },
    {
      "key": "identity.age",
      "depends_on": ["routing.health_travel_insurance_status"],
      "label": "What is your age?",
      "input_type": "number",
      "required": true
    },
    {
      "key": "routing.police_clearance_available",
      "depends_on": ["identity.age"],
      "label": "Can you obtain the required criminal record certificate from your country of nationality and any country where you have lived for more than 1 year?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "greater_than_or_equal": ["identity.age", 16] }
    },
    {
      "key": "routing.criminal_record_flag",
      "depends_on": ["routing.police_clearance_available"],
      "label": "Do you have any criminal convictions that may appear on a background check?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"],
      "applies_when": { "greater_than_or_equal": ["identity.age", 16] }
    },
    {
      "key": "routing.removal_or_refusal_alert_flag",
      "depends_on": ["routing.criminal_record_flag"],
      "label": "Are you currently subject to an active entry or stay ban, removal order, or SII/UCFE refusal alert that may affect residence in Portugal?",
      "input_type": "choice",
      "required": true,
      "choices": ["yes", "no"]
    }
  ],
  "post_eligibility_checklist": {
    "note": "These are real Portugal Digital Nomad Visa requirements sourced from requirements_reference.md, but they describe post-entry / renewal-stage compliance steps, or application-preparation content, rather than facts needed to determine INITIAL visa eligibility. They were removed from the live eligibility-screening flow and are preserved here for a future post-eligibility guidance surface. Their former requirement codes still exist in clarifications.json for that purpose.",
    "fields": [
      {
        "key": "compliance.aima_residence_permit_acknowledged",
        "label": "Do you understand that after entry with a residence visa, you must apply to AIMA for the residence permit?",
        "input_type": "choice",
        "choices": ["yes", "no"],
        "applies_when": { "equals": ["routing.visa_route", "residence_visa"] },
        "related_requirement": "aima_residence_permit_acknowledgement_needs_review"
      },
      {
        "key": "compliance.renewal_acknowledged",
        "label": "Do you understand the remote-work residence authorization is initially valid for 2 years and may be renewed for successive 3-year periods if requirements remain satisfied?",
        "input_type": "choice",
        "choices": ["yes", "no"],
        "applies_when": { "equals": ["routing.visa_route", "residence_visa"] },
        "related_requirement": "renewal_acknowledgement_needs_review"
      }
    ]
  }
}
